# Postgres connection used by the web app and drizzle-kit migrations.
# Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgres://kanbot:kanbot@localhost:5432/kanbot

# Worker (apps/worker). Claude Console API key for the Kanbot workspace; never commit a real one.
ANTHROPIC_API_KEY=
# sdk (default) runs real agents through the Claude Agent SDK; replay plays fixtures/runs/<agent>/<scenario>.json
# (scenario = a ticket label `replay:<name>`, else `default`) and never calls the API.
KANBOT_RUNTIME=sdk
