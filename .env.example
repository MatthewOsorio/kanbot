# Postgres connection used by the web app and drizzle-kit migrations.
# Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgres://kanbot:kanbot@localhost:5432/kanbot

# Sign in with GitHub (web app). Each one: openssl rand -base64 32. The session secret signs the login
# cookie (changing it signs everyone out); the encryption key protects the GitHub App's stored credentials
# (changing it loses them: Connect GitHub again).
KANBOT_SESSION_SECRET=
KANBOT_ENCRYPTION_KEY=

# Worker (apps/worker). Claude Console API key for the Kanbot workspace; never commit a real one.
ANTHROPIC_API_KEY=
# sdk (default) runs real agents through the Claude Agent SDK; replay plays fixtures/runs/<agent>/<scenario>.json
# (scenario = a ticket label `replay:<name>`, else `default`) and never calls the API.
KANBOT_RUNTIME=sdk
# 1 = save every real run on a ticket labelled `replay:<scenario>` as fixtures/runs/<agent>/<scenario>.<n>.json
# (used with `pnpm eval:agents` to record the golden tickets). Costs real money; leave unset normally.
KANBOT_RECORD=

# Optional overrides (defaults shown): where the worker and web app find agents, plugins and replay
# scripts (relative to apps/<app>), and the database the tests, e2e and `pnpm eval:agents` use.
# KANBOT_AGENTS_DIR=../../agents
# KANBOT_PLUGINS_DIR=../../plugins
# KANBOT_FIXTURES_DIR=../../fixtures/runs
# TEST_DATABASE_URL=postgres://kanbot:kanbot@localhost:5432/kanbot_test

# Running the whole stack in Docker (docs/deploy.md: WSL or a server); unused in local development.
# COMPOSE_PROFILES=app                    app = migrate, web, worker; app,public adds Caddy (servers, after login)
# KANBOT_DOMAIN=kanbot.example.com        Caddy serves HTTPS for this name
# KANBOT_WEB_PORT=3000                    the web app on 127.0.0.1
# KANBOT_DEFAULT_IMAGE=node:24-bookworm   image for projects with none of their own
# POSTGRES_PASSWORD=                      a long random string; local default is "kanbot"
# DOCKER_SOCKET=/run/user/1000/docker.sock   the rootless Docker daemon's socket, mounted into the worker
# KANBOT_REPOS_DIR=/srv/kanbot/repos      cloned repos and worktrees, mounted at the same path in the worker
# KANBOT_DB_PORT=5432                     Postgres on 127.0.0.1 (a second stack on one machine needs another)
