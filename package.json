{
  "name": "kanbot",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kanbot/web dev",
    "build": "pnpm --filter @kanbot/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @kanbot/web test:e2e",
    "db:generate": "pnpm --filter @kanbot/shared db:generate",
    "db:migrate": "pnpm --filter @kanbot/shared db:migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
