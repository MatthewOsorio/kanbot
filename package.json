{
  "name": "kanbot",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kanbot/web --filter @kanbot/worker dev",
    "build": "pnpm --filter @kanbot/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @kanbot/web test:e2e",
    "db:generate": "pnpm --filter @kanbot/shared db:generate",
    "db:migrate": "pnpm --filter @kanbot/shared db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter @kanbot/web dev",
    "dev:worker": "pnpm --filter @kanbot/worker dev",
    "eval:agents": "pnpm --filter @kanbot/worker eval"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "^10.14.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
