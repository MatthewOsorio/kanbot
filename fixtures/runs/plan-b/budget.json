      "type": "assistant",
      "payload": {
        "text": "Reading the board component."
      },
      "delayMs": 0
    },
    {
      "type": "tool_call",
      "payload": {
        "id": "t1",
        "name": "Read",
        "input": {
          "file_path": "apps/web/components/board.tsx"
        }
      },
      "delayMs": 0
